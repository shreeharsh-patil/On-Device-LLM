<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application splash/launch theme (Warm Vellum day mode).
         Actual runtime UI is styled by Jetpack Compose OnDeviceQwenTheme. -->
    <style name="Theme.OnDeviceQwen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sovereign_cyan_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ink_dark</item>
        <item name="colorOnSecondary">@color/vellum_canvas</item>
        <item name="android:windowBackground">@color/vellum_canvas</item>
        <item name="android:colorBackground">@color/vellum_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
