<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="database" path="qwen_chat.db" />
    <exclude domain="database" path="qwen_chat.db-wal" />
    <exclude domain="database" path="qwen_chat.db-shm" />
    <exclude domain="database" path="qwen_chat.db-journal" />
    <exclude domain="sharedpref" path="on_device_qwen_prefs.xml" />
    <exclude domain="file" path="models" />
    <exclude domain="root" path="cache" />
    <exclude domain="root" path="code_cache" />
</full-backup-content>